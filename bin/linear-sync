#!/bin/zsh
# linear-sync — loop de spawn Linear→Orca: issue em Todo → worktree + agente.
#
# Uso:
#   linear-sync              processa todas as issues Todo do team
#   linear-sync --only KEY   processa somente a issue KEY
#   linear-sync --dry-run    relata o que faria, sem criar nem mutar nada
#   linear-sync --queue --json
#                             só computa e emite a fila ordenada (sem spawnar
#                             nem mutar nada) — contrato único da ordenação;
#                             consumido pelo wos, que não a reimplementa.
#
# Gate: só issues do team (WORK_LINEAR_TEAM, default HEN) em estado Todo.
# Agente: LINEAR_SYNC_AGENT (default claude) — qualquer TUI agent que o Orca
# conheça (`--agent` do worktree create; ex.: claude, pi, codex).
# Fluxo de integração (decisão 2026-07-18): worktrees partem da branch longa
# de integração LINEAR_SYNC_BASE (default dev); cada task vira UM commit
# squash na dev (PR contra dev, merge imediato pelo agente). A revisão humana
# é em lote: PR dev→main quando o Henrique quiser — main continua manual.
# Repo alvo: trailer "repo: `<canonicalKey>`" no body da issue (criado pela
# captura `work`); sem trailer, ou repo não registrado no Orca → pendência,
# não spawna. Cap de paralelismo: LINEAR_SYNC_CAP (default 2) worktrees
# ativos vinculados a issue; excedentes ficam em Todo (fila). Dedup por
# issue-key via `orca worktree list` — rodar de novo não duplica worktree.
#
# Modelo/effort (HEN-38, só p/ agente claude) — precedência da resolução:
#   1. env LINEAR_SYNC_MODEL / LINEAR_SYNC_EFFORT (é assim que `wos spawn`
#      passa as flags de CLI; override consciente vence tudo)
#   2. trailer "agent-config: `model=<m> effort=<e>`" no body da issue
#      (linha própria, última ocorrência vence — mesmo estilo do repo:)
#   3. política default: sonnet/medium (rotina). Valores: model
#      sonnet|opus|haiku, effort low|medium|high.
# Mecanismo: worktree sem --agent + `claude --model <m> --effort <e>` enviado
# ao terminal inicial (o launcher nativo do Orca não expõe modelo/effort).
# Agente ≠ claude → caminho legado `worktree create --agent`, sem modelo/effort.

set -o pipefail

# $0 dentro de função vira o nome da função (FUNCTION_ARGZERO); capturar aqui.
SELF="$0"

TEAM="${WORK_LINEAR_TEAM:-HEN}"
CAP="${LINEAR_SYNC_CAP:-2}"
AGENT="${LINEAR_SYNC_AGENT:-claude}"
BASE="${LINEAR_SYNC_BASE:-dev}"

# Overrides de modelo/effort (vazio = sem override; resolução por issue).
MODEL_OVERRIDE="${LINEAR_SYNC_MODEL:-}"
EFFORT_OVERRIDE="${LINEAR_SYNC_EFFORT:-}"
typeset -a VALID_MODELS=(sonnet opus haiku)
typeset -a VALID_EFFORTS=(low medium high)
DEFAULT_MODEL=sonnet
DEFAULT_EFFORT=medium

usage() {
  # Todo o bloco de comentário do cabeçalho (até a primeira linha em branco).
  sed -n '2,/^$/p' "$SELF" | sed 's/^# \{0,1\}//'
}

die() {
  print -u2 "linear-sync: $*"
  exit 1
}

# Envelope JSON do orca com ok:true? (JSON pode ter control chars crus → strict=False)
json_ok() {
  RAW="$1" python3 - <<'PY'
import json, os, sys
try:
    d = json.loads(os.environ["RAW"], strict=False)
except Exception:
    sys.exit(1)
sys.exit(0 if d.get("ok") else 1)
PY
}

# Prompt inicial do agente no worktree spawnado. Heredoc quotado: os backticks
# são literais (não command substitution); a key entra via sed.
agent_prompt() {
  sed "s/__KEY__/$1/g" <<'EOF'
Você é o agente de código deste worktree Orca, vinculado à issue Linear __KEY__.

Contexto primeiro (nesta ordem):
1. `orca linear issue --current --full --json` — sua issue; o aceite está na description; leia também comentários, anexos e relações.
2. Suas instruções globais e do repo (CLAUDE.md/AGENTS.md) — siga a matriz de autonomia.
3. `orca agent-context --json` — fonte de verdade do schema dos comandos `orca`; não decore flags.

Contrato de trabalho:
- Fluxo: commits na sua branch → PR contra a branch de integração `dev` (`gh pr create --base dev`) → você mesmo faz o merge squash (`gh pr merge --squash --delete-branch`). Cada task = UM commit na dev. NUNCA abra PR contra main — a revisão humana acontece em lote, no PR dev→main.
- Conflito ao integrar na dev, ou dúvida de design: pergunte (gate), não force.
- Evidência antes de integrar (saídas de testes no corpo do PR). Anexe o PR à issue: `orca linear attach --current --url <pr-url> --title "PR"`.
- Integrou na dev → mova a issue: `orca linear status set --current --to Done`.
- Corpos multiline no CLI sempre via `--body-file -`.
- Ao fechar, deixe comentário `## Lessons` na issue (surpresas, o que o spec não cobriu).
EOF
}

# ---------- args ----------
dry_run=0
only=""
queue_mode=0
json_out=0
while (( $# )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --dry-run) dry_run=1 ;;
    --queue) queue_mode=1 ;;
    --json) json_out=1 ;;
    --only)
      shift
      [[ -n "$1" ]] || die "--only requer uma issue key (ex.: HEN-42)"
      only="${(U)1}"
      ;;
    *) usage >&2; die "argumento desconhecido: $1" ;;
  esac
  shift
done

(( queue_mode )) && [[ "$json_out" -ne 1 ]] && die "--queue requer --json (único formato de saída suportado)"

[[ "$CAP" == <-> ]] || die "LINEAR_SYNC_CAP inválido: $CAP"
[[ -z "$MODEL_OVERRIDE" || ${VALID_MODELS[(Ie)$MODEL_OVERRIDE]} -gt 0 ]] ||
  die "LINEAR_SYNC_MODEL inválido: $MODEL_OVERRIDE (use: $VALID_MODELS)"
[[ -z "$EFFORT_OVERRIDE" || ${VALID_EFFORTS[(Ie)$EFFORT_OVERRIDE]} -gt 0 ]] ||
  die "LINEAR_SYNC_EFFORT inválido: $EFFORT_OVERRIDE (use: $VALID_EFFORTS)"

issues_raw=$(orca linear list --filter open --team "$TEAM" --limit 100 --json 2>&1)
json_ok "$issues_raw" || die "falha em \`orca linear list\`"

# ---------- --queue --json: só computa e emite a fila, sem mutar nada ----------
# Contrato único da ordenação (aceite HEN-57): prioridade Linear urgent→low,
# sem prioridade por último; desempate pelo número da key. wos consome esta
# saída em vez de recalcular a chave de ordenação.
if (( queue_mode )); then
  RAW="$issues_raw" TEAM="$TEAM" python3 - <<'PY'
import json, os
d = json.loads(os.environ["RAW"], strict=False)
team = os.environ["TEAM"]
todo = []
for i in d.get("result", {}).get("issues", []):
    if (i.get("state") or {}).get("name") != "Todo":
        continue
    if (i.get("team") or {}).get("key") != team:
        continue
    p = i.get("priority") or 0
    try:
        num = int(i["identifier"].rsplit("-", 1)[-1])
    except ValueError:
        num = 10**9
    todo.append((0 if p else 1, p, num, i["identifier"], i.get("title") or ""))
prio_label = {0: "—", 1: "P1", 2: "P2", 3: "P3", 4: "P4"}
queue = [
    {"key": key, "priority": p, "priorityLabel": prio_label.get(p, "?"), "title": title}
    for _, p, _, key, title in sorted(todo)
]
print(json.dumps({"ok": True, "result": {"queue": queue}}))
PY
  exit 0
fi

# ---------- estado atual: repos, worktrees, issues ----------
repos_raw=$(orca repo list --json 2>&1)
json_ok "$repos_raw" || die "falha em \`orca repo list\` — runtime do Orca fora do ar? tente \`orca open\`"

repo_lines=$(RAW="$repos_raw" python3 - <<'PY'
import json, os
d = json.loads(os.environ["RAW"], strict=False)
for r in d.get("result", {}).get("repos", []):
    key = (r.get("gitRemoteIdentity") or {}).get("canonicalKey")
    if key:
        print(key + "\t" + r["id"])
PY
)
typeset -A repo_id
for line in ${(f)repo_lines}; do
  repo_id[${line%%$'\t'*}]="${line#*$'\t'}"
done

wt_raw=$(orca worktree list --json 2>&1)
json_ok "$wt_raw" || die "falha em \`orca worktree list\`"

linked_lines=$(RAW="$wt_raw" python3 - <<'PY'
import json, os
d = json.loads(os.environ["RAW"], strict=False)
for w in d.get("result", {}).get("worktrees", []):
    if w.get("isArchived"):
        continue
    key = w.get("linkedLinearIssue")
    if key:
        print(key)
PY
)
typeset -a linked=( ${(f)linked_lines} )
running=${#linked[@]}

# Candidatas: estado Todo no team. Fila ordenada por prioridade Linear
# (urgent→low, sem prioridade por último), depois por key (FIFO aproximado).
todo_lines=$(RAW="$issues_raw" TEAM="$TEAM" python3 - <<'PY'
import json, os
d = json.loads(os.environ["RAW"], strict=False)
team = os.environ["TEAM"]
todo = []
for i in d.get("result", {}).get("issues", []):
    if (i.get("state") or {}).get("name") != "Todo":
        continue
    if (i.get("team") or {}).get("key") != team:
        continue
    p = i.get("priority") or 0
    try:
        num = int(i["identifier"].rsplit("-", 1)[-1])
    except ValueError:
        num = 10**9
    todo.append((0 if p else 1, p, num, i["identifier"]))
for _, _, _, key in sorted(todo):
    print(key)
PY
)
typeset -a todo=( ${(f)todo_lines} )

override_note=""
[[ -n "$MODEL_OVERRIDE" || -n "$EFFORT_OVERRIDE" ]] &&
  override_note=" · override ${MODEL_OVERRIDE:-·}/${EFFORT_OVERRIDE:-·}"
print "linear-sync · team $TEAM · agente $AGENT$override_note · base $BASE · cap $CAP · worktrees ativos vinculados: $running · em Todo: ${#todo[@]}"
(( dry_run )) && print "(dry-run: nada será criado nem mutado)"

# ---------- loop por issue ----------
typeset -a spawned queued pendencias deduped
matched_only=0

for key in "${todo[@]}"; do
  [[ -n "$only" && "$key" != "$only" ]] && continue
  matched_only=1

  if (( ${linked[(Ie)$key]} )); then
    print "= $key · dedup: já vinculada a worktree ativo — nada a fazer"
    deduped+=("$key")
    continue
  fi

  issue_raw=$(orca linear issue "$key" --json 2>&1)
  if ! json_ok "$issue_raw"; then
    print "! $key · pendência: falha ao ler a issue"
    pendencias+=("$key")
    continue
  fi

  # linha 1: canonicalKey do trailer (ou "-"); linha 2: nome do worktree
  # (slug do branchName sugerido pelo Linear, sem o prefixo de usuário);
  # linhas 3 e 4: model/effort do trailer agent-config (ou "-").
  info=$(RAW="$issue_raw" python3 - <<'PY'
import json, os, re
d = json.loads(os.environ["RAW"], strict=False)
issue = d["result"]["issue"]
desc = issue.get("description") or ""
# Trailers = linha própria; última ocorrência vence (o body pode citar o
# formato como exemplo no meio do texto — ex.: specs de tooling do Work OS).
ms = re.findall(r"(?m)^repo: `([^`]+)`\s*$", desc)
print(ms[-1] if ms else "-")
branch = issue.get("branchName") or ""
print(branch.rsplit("/", 1)[-1] if branch else issue["identifier"].lower())
cfgs = re.findall(r"(?m)^agent-config: `([^`]+)`\s*$", desc)
cfg = cfgs[-1] if cfgs else ""
for field in ("model", "effort"):
    m = re.search(r"\b%s=([a-z-]+)" % field, cfg)
    print(m.group(1) if m else "-")
PY
)
  info_lines=( ${(f)info} )
  repo_key="${info_lines[1]}"
  wt_name="${info_lines[2]}"
  t_model="${info_lines[3]}"
  t_effort="${info_lines[4]}"

  # Resolução modelo/effort: env (wos spawn) > trailer válido > default.
  # Trailer inválido não bloqueia o spawn: avisa e cai no default.
  [[ "$t_model" == - ]] && t_model=""
  [[ "$t_effort" == - ]] && t_effort=""
  if [[ -n "$t_model" && ${VALID_MODELS[(Ie)$t_model]} -eq 0 ]]; then
    print "  ⚠ $key · trailer agent-config com model inválido '$t_model' — ignorando"
    t_model=""
  fi
  if [[ -n "$t_effort" && ${VALID_EFFORTS[(Ie)$t_effort]} -eq 0 ]]; then
    print "  ⚠ $key · trailer agent-config com effort inválido '$t_effort' — ignorando"
    t_effort=""
  fi
  model="${MODEL_OVERRIDE:-${t_model:-$DEFAULT_MODEL}}"
  effort="${EFFORT_OVERRIDE:-${t_effort:-$DEFAULT_EFFORT}}"

  if [[ "$repo_key" == "-" ]]; then
    print "! $key · pendência: sem trailer 'repo: \`…\`' no body — capture com \`work\` dentro do repo, ou adicione o trailer"
    pendencias+=("$key")
    continue
  fi
  if [[ -z "${repo_id[$repo_key]}" ]]; then
    print "! $key · pendência: repo $repo_key não registrado no Orca (rode \`orca repo add\`)"
    pendencias+=("$key")
    continue
  fi

  if (( running >= CAP )); then
    print "• $key · fila: cap $CAP atingido — fica em Todo"
    queued+=("$key")
    continue
  fi

  agent_desc="$AGENT"
  [[ "$AGENT" == claude ]] && agent_desc="claude $model/$effort"

  if (( dry_run )); then
    print "→ $key · [dry-run] spawnaria worktree '$wt_name' em $repo_key + $agent_desc, e moveria p/ In Progress"
    spawned+=("$key")
    (( running++ ))
    continue
  fi

  if [[ "$AGENT" == claude ]]; then
    # Claude com modelo/effort: o launcher nativo do Orca não expõe as flags,
    # então o worktree nasce sem agente e o claude entra pelo terminal inicial.
    create_raw=$(orca worktree create --repo "id:${repo_id[$repo_key]}" --name "$wt_name" \
      --base-branch "$BASE" \
      --linear-issue "$key" --no-parent --json 2>&1)
    if ! json_ok "$create_raw"; then
      print "✗ $key · falha no \`orca worktree create\`:"
      print -r -- "$create_raw" | head -5
      pendencias+=("$key")
      continue
    fi
    wt_path=$(RAW="$create_raw" python3 - <<'PY'
import json, os
d = json.loads(os.environ["RAW"], strict=False)
w = d.get("result", {}).get("worktree", d.get("result", {}))
print(w.get("path", ""))
PY
)
    # O terminal inicial do worktree nasce assíncrono — poll curto.
    handle=""
    for _ in {1..15}; do
      handle=$(RAW="$(orca terminal list --worktree "path:$wt_path" --json 2>/dev/null)" python3 - <<'PY' 2>/dev/null
import json, os
d = json.loads(os.environ["RAW"], strict=False)
ts = d.get("result", {}).get("terminals", []) if d.get("ok") else []
print(ts[0]["handle"] if ts else "")
PY
)
      [[ -n "$handle" ]] && break
      sleep 1
    done

    prompt="$(agent_prompt "$key")"
    claude_cmd="claude --dangerously-skip-permissions --model $model --effort $effort ${(qq)prompt}"
    launched=0
    send_raw=""
    if [[ -n "$handle" ]]; then
      send_raw=$(orca terminal send --terminal "$handle" --text "$claude_cmd" --enter --json 2>&1)
      json_ok "$send_raw" && launched=1
    fi
    if (( ! launched )); then
      # fallback: pane nova já com o comando (fica um shell ocioso na primeira)
      send_raw=$(orca terminal create --worktree "path:$wt_path" --command "$claude_cmd" --json 2>&1)
      json_ok "$send_raw" && launched=1
    fi
    if (( ! launched )); then
      print "✗ $key · worktree '$wt_name' criado e vinculado, mas o claude não subiu no terminal:"
      print -r -- "$send_raw" | head -3
      print "  → rode no pane do worktree: $claude_cmd"
      pendencias+=("$key")
      (( running++ ))
      continue
    fi
  else
    # Caminho legado (agentes ≠ claude): launcher nativo, sem modelo/effort.
    create_raw=$(orca worktree create --repo "id:${repo_id[$repo_key]}" --name "$wt_name" \
      --base-branch "$BASE" \
      --linear-issue "$key" --agent "$AGENT" --prompt "$(agent_prompt "$key")" --no-parent --json 2>&1)
    if ! json_ok "$create_raw"; then
      print "✗ $key · falha no \`orca worktree create\`:"
      print -r -- "$create_raw" | head -5
      pendencias+=("$key")
      continue
    fi
  fi

  st_raw=$(orca linear status set "$key" --to "In Progress" --json 2>&1)
  if json_ok "$st_raw"; then
    print "✓ $key → worktree '$wt_name' ($repo_key) · $agent_desc rodando · In Progress"
  else
    print "✓ $key → worktree '$wt_name' ($repo_key) · $agent_desc rodando · ⚠ falha ao mover p/ In Progress — mova manualmente"
  fi
  spawned+=("$key")
  (( running++ ))
done

if [[ -n "$only" && $matched_only -eq 0 ]]; then
  die "$only não está em Todo no team $TEAM — gate: só issues em Todo entram no sync"
fi

label_spawn="spawn"
(( dry_run )) && label_spawn="spawn (dry-run)"
print ""
print "resumo: ${#spawned[@]} $label_spawn · ${#queued[@]} fila · ${#pendencias[@]} pendência(s) · ${#deduped[@]} dedup"

# Com --only, sinaliza no exit code quando a issue pedida não avançou
# (pendência ou fila); dedup conta como sucesso idempotente.
if [[ -n "$only" ]] && (( ${#spawned[@]} == 0 && ${#deduped[@]} == 0 )); then
  exit 1
fi
exit 0
