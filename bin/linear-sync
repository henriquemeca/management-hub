#!/bin/zsh
# linear-sync — loop de spawn Linear→workmux: issue em Todo → worktree + agente.
#
# Uso:
#   linear-sync              processa todas as issues Todo do team
#   linear-sync --only KEY   processa somente a issue KEY
#   linear-sync --dry-run    relata o que faria, sem criar nem mutar nada
#   linear-sync --queue --json
#                             só computa e emite a fila ordenada (sem spawnar
#                             nem mutar nada) — contrato único da ordenação;
#                             consumido pelo wos, que não a reimplementa.
#
# Gate: só issues do team (WORK_LINEAR_TEAM, default HEN) em estado Todo.
# Fluxo de integração (decisão 2026-07-18): worktrees partem da branch longa
# de integração LINEAR_SYNC_BASE (default dev); cada task vira UM commit
# squash na dev (PR contra dev, merge imediato pelo agente). A revisão humana
# é em lote: PR dev→main quando o Henrique quiser — main continua manual.
# Repo alvo: trailer "repo: `<canonicalKey>`" no body da issue (criado pela
# captura `work`); canonicalKey→path vem do registro
# ~/.local/state/work-os/repos.json. Sem trailer, ou repo fora do registro →
# pendência, não spawna. Cap de paralelismo: LINEAR_SYNC_CAP (default 2)
# janelas tmux 'wm-*' ativas; excedentes ficam em Todo (fila). Dedup por
# slug: worktree em ~/worktrees/<project>/<slug> OU janela tmux 'wm-<slug>'
# viva → rodar de novo não duplica worktree.
#
# Modelo/effort (HEN-38) — precedência da resolução:
#   1. env LINEAR_SYNC_MODEL / LINEAR_SYNC_EFFORT (é assim que `wos spawn`
#      passa as flags de CLI; override consciente vence tudo)
#   2. trailer "agent-config: `model=<m> effort=<e>`" no body da issue
#      (linha própria, última ocorrência vence — mesmo estilo do repo:)
#   3. política default: sonnet/medium (rotina). Valores: model
#      sonnet|opus|haiku, effort low|medium|high.
# Mecanismo: perfis do workmux — (haiku,low)→cc-haiku-low,
# (sonnet,medium)→cc-sonnet-medium, (sonnet,high)→cc-sonnet-high,
# (opus,high)→cc-opus-high; combinação sem perfil → warn + cc-sonnet-medium.

set -o pipefail

# $0 dentro de função vira o nome da função (FUNCTION_ARGZERO); capturar aqui.
SELF="$0"

TEAM="${WORK_LINEAR_TEAM:-HEN}"
CAP="${LINEAR_SYNC_CAP:-2}"
BASE="${LINEAR_SYNC_BASE:-dev}"
REPOS_JSON="$HOME/.local/state/work-os/repos.json"
WORKTREES_ROOT="$HOME/worktrees"

# Overrides de modelo/effort (vazio = sem override; resolução por issue).
MODEL_OVERRIDE="${LINEAR_SYNC_MODEL:-}"
EFFORT_OVERRIDE="${LINEAR_SYNC_EFFORT:-}"
typeset -a VALID_MODELS=(sonnet opus haiku)
typeset -a VALID_EFFORTS=(low medium high)
DEFAULT_MODEL=sonnet
DEFAULT_EFFORT=medium

usage() {
  # Todo o bloco de comentário do cabeçalho (até a primeira linha em branco).
  sed -n '2,/^$/p' "$SELF" | sed 's/^# \{0,1\}//'
}

die() {
  print -u2 "linear-sync: $*"
  exit 1
}

# Perfil workmux para (model, effort). Combinação fora da tabela → warn +
# default cc-sonnet-medium (não bloqueia o spawn).
profile_for() {
  case "$1/$2" in
    haiku/low)     print cc-haiku-low ;;
    sonnet/medium) print cc-sonnet-medium ;;
    sonnet/high)   print cc-sonnet-high ;;
    opus/high)     print cc-opus-high ;;
    *)
      print -u2 "  ⚠ combinação $1/$2 sem perfil workmux — usando cc-sonnet-medium"
      print cc-sonnet-medium
      ;;
  esac
}

# Prompt inicial do agente no worktree spawnado. Heredoc quotado: os backticks
# são literais (não command substitution); key e base entram via sed.
agent_prompt() {
  sed -e "s/__KEY__/$1/g" -e "s/__BASE__/$BASE/g" <<'EOF'
Você é o agente de código deste worktree, vinculado à issue Linear __KEY__.

Contexto primeiro (nesta ordem):
1. A spec acima traz a description da issue (o aceite está nela); comentários e sub-issues: `linear-gql issue __KEY__`.
2. Suas instruções globais e do repo (CLAUDE.md/AGENTS.md) — siga a matriz de autonomia.

Contrato de trabalho:
- Fluxo: commits na sua branch → PR contra a branch de integração `__BASE__` (`gh pr create --base __BASE__`) → você mesmo faz o merge squash (`gh pr merge --squash --delete-branch`). Cada task = UM commit na __BASE__. NUNCA abra PR contra main — a revisão humana acontece em lote, no PR __BASE__→main.
- Conflito ao integrar na __BASE__, ou dúvida de design: abra um gate (`gates create --task "__KEY__" --question "<pergunta>"`) e aguarde — não force.
- Evidência antes de integrar (saídas de testes no corpo do PR). Anexe o PR à issue: `linear-gql comment __KEY__ --body-file -` com o link do PR.
- Integrou na __BASE__ → NÃO mova a issue para Done nem rode `workmux merge`: o fechamento (status + limpeza do worktree) é do `ship`.
- Corpos multiline no CLI sempre via `--body-file -`.
- Ao fechar, deixe comentário `## Lessons` na issue (surpresas, o que o spec não cobriu): `linear-gql comment __KEY__ --body-file -`.
EOF
}

# ---------- args ----------
dry_run=0
only=""
queue_mode=0
json_out=0
while (( $# )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --dry-run) dry_run=1 ;;
    --queue) queue_mode=1 ;;
    --json) json_out=1 ;;
    --only)
      shift
      [[ -n "$1" ]] || die "--only requer uma issue key (ex.: HEN-42)"
      only="${(U)1}"
      ;;
    *) usage >&2; die "argumento desconhecido: $1" ;;
  esac
  shift
done

(( queue_mode )) && [[ "$json_out" -ne 1 ]] && die "--queue requer --json (único formato de saída suportado)"

[[ "$CAP" == <-> ]] || die "LINEAR_SYNC_CAP inválido: $CAP"
[[ -z "$MODEL_OVERRIDE" || ${VALID_MODELS[(Ie)$MODEL_OVERRIDE]} -gt 0 ]] ||
  die "LINEAR_SYNC_MODEL inválido: $MODEL_OVERRIDE (use: $VALID_MODELS)"
[[ -z "$EFFORT_OVERRIDE" || ${VALID_EFFORTS[(Ie)$EFFORT_OVERRIDE]} -gt 0 ]] ||
  die "LINEAR_SYNC_EFFORT inválido: $EFFORT_OVERRIDE (use: $VALID_EFFORTS)"

# ---------- estado atual: repos, janelas wm-*, issues ----------
[[ -f "$REPOS_JSON" ]] || die "registro de repos ausente: $REPOS_JSON — capture repos com \`work\` primeiro"
repo_lines=$(REPOS_JSON="$REPOS_JSON" python3 - <<'PY'
import json, os, sys
try:
    d = json.load(open(os.environ["REPOS_JSON"]))
except Exception as e:
    print(f"registro de repos ilegível: {e}", file=sys.stderr)
    sys.exit(1)
for key, path in d.items():
    print(key + "\t" + path)
PY
) || die "falha ao ler $REPOS_JSON"
typeset -A repo_path_of
for line in ${(f)repo_lines}; do
  repo_path_of[${line%%$'\t'*}]="${line#*$'\t'}"
done

# Janelas tmux de agentes: nome 'wm-<slug>'. Contagem = cap; nome = dedup.
typeset -a wm_windows=( ${(f)"$(tmux list-windows -a -F '#{window_name}' 2>/dev/null | grep '^wm-')"} )
running=${#wm_windows[@]}

issues_raw=$(linear-gql list --team "$TEAM" --state Todo --limit 100) ||
  die "falha em \`linear-gql list\` — rede/API do Linear fora do ar?"

# ---------- --queue --json: só computa e emite a fila, sem mutar nada ----------
# Contrato único da ordenação (aceite HEN-57): prioridade Linear urgent→low,
# sem prioridade por último; desempate pelo número da key. wos consome esta
# saída em vez de recalcular a chave de ordenação.
if (( queue_mode )); then
  RAW="$issues_raw" TEAM="$TEAM" python3 - <<'PY'
import json, os
d = json.loads(os.environ["RAW"], strict=False)
team = os.environ["TEAM"]
todo = []
for i in d.get("issues", []):
    if (i.get("state") or {}).get("name") != "Todo":
        continue
    if (i.get("team") or {}).get("key") != team:
        continue
    p = i.get("priority") or 0
    try:
        num = int(i["identifier"].rsplit("-", 1)[-1])
    except ValueError:
        num = 10**9
    todo.append((0 if p else 1, p, num, i["identifier"], i.get("title") or ""))
prio_label = {0: "—", 1: "P1", 2: "P2", 3: "P3", 4: "P4"}
queue = [
    {"key": key, "priority": p, "priorityLabel": prio_label.get(p, "?"), "title": title}
    for _, p, _, key, title in sorted(todo)
]
print(json.dumps({"ok": True, "result": {"queue": queue}}))
PY
  exit 0
fi

# Diretório de trabalho por rodada: descriptions + specs de spawn.
spec_dir=$(mktemp -d "${TMPDIR:-/tmp}/linear-sync.XXXXXX") || die "mktemp falhou"

# Candidatas: estado Todo no team (o filtro é server-side; revalidado aqui).
# Fila ordenada por prioridade Linear (urgent=1→low=4, prioridade 0/ausente
# por último), depois por número da key (FIFO aproximado). Por issue, uma
# linha TSV: key, slug (branchName após a última '/', fallback identifier
# minúsculo), repo canonicalKey do trailer (ou "-"), model e effort do
# trailer agent-config (ou "-"). Trailers = linha própria; última ocorrência
# vence (o body pode citar o formato como exemplo — bug HEN-37). A
# description completa vai para $spec_dir/<key>.desc.
todo_lines=$(RAW="$issues_raw" TEAM="$TEAM" SPEC_DIR="$spec_dir" python3 - <<'PY'
import json, os, re, sys
try:
    d = json.loads(os.environ["RAW"], strict=False)
except Exception:
    print("resposta do linear-gql não é JSON", file=sys.stderr)
    sys.exit(1)
team = os.environ["TEAM"]
spec_dir = os.environ["SPEC_DIR"]
todo = []
for i in d.get("issues", []):
    if (i.get("state") or {}).get("name") != "Todo":
        continue
    if (i.get("team") or {}).get("key") != team:
        continue
    key = i["identifier"]
    desc = i.get("description") or ""
    ms = re.findall(r"(?m)^repo: `([^`]+)`\s*$", desc)
    repo = ms[-1] if ms else "-"
    branch = i.get("branchName") or ""
    slug = branch.rsplit("/", 1)[-1] if branch else key.lower()
    cfgs = re.findall(r"(?m)^agent-config: `([^`]+)`\s*$", desc)
    cfg = cfgs[-1] if cfgs else ""
    mo = re.search(r"\bmodel=([a-z-]+)", cfg)
    ef = re.search(r"\beffort=([a-z-]+)", cfg)
    p = i.get("priority") or 0
    try:
        num = int(key.rsplit("-", 1)[-1])
    except ValueError:
        num = 10**9
    with open(os.path.join(spec_dir, key + ".desc"), "w") as f:
        f.write(desc)
    todo.append((0 if p else 1, p, num,
                 "\t".join([key, slug, repo,
                            mo.group(1) if mo else "-",
                            ef.group(1) if ef else "-"])))
for t in sorted(todo):
    print(t[-1])
PY
) || die "falha ao parsear a fila do Linear"
typeset -a todo=( ${(f)todo_lines} )

override_note=""
[[ -n "$MODEL_OVERRIDE" || -n "$EFFORT_OVERRIDE" ]] &&
  override_note=" · override ${MODEL_OVERRIDE:-·}/${EFFORT_OVERRIDE:-·}"
print "linear-sync · team $TEAM$override_note · base $BASE · cap $CAP · janelas wm-* ativas: $running · em Todo: ${#todo[@]}"
(( dry_run )) && print "(dry-run: nada será criado nem mutado)"

# ---------- loop por issue ----------
typeset -a spawned queued pendencias deduped
matched_only=0

for line in "${todo[@]}"; do
  IFS=$'\t' read -r key slug repo_key t_model t_effort <<< "$line"
  [[ -n "$only" && "$key" != "$only" ]] && continue
  matched_only=1

  # Dedup: janela tmux viva OU worktree no disco → issue já tem agente/worktree.
  if (( ${wm_windows[(Ie)wm-$slug]} )); then
    print "= $key · dedup: janela tmux 'wm-$slug' viva — nada a fazer"
    deduped+=("$key")
    continue
  fi
  # {project} do workmux = basename do DIRETÓRIO do repo (ex.: .dotfiles),
  # não o segmento do canonicalKey (dotfiles) — derivar do path registrado.
  proj_dir="${repo_path_of[$repo_key]:t}"
  if [[ "$repo_key" != "-" && -n "$proj_dir" && -d "$WORKTREES_ROOT/$proj_dir/$slug" ]]; then
    print "= $key · dedup: worktree $WORKTREES_ROOT/$proj_dir/$slug existe — nada a fazer"
    deduped+=("$key")
    continue
  fi

  # Resolução modelo/effort: env (wos spawn) > trailer válido > default.
  # Trailer inválido não bloqueia o spawn: avisa e cai no default.
  [[ "$t_model" == - ]] && t_model=""
  [[ "$t_effort" == - ]] && t_effort=""
  if [[ -n "$t_model" && ${VALID_MODELS[(Ie)$t_model]} -eq 0 ]]; then
    print "  ⚠ $key · trailer agent-config com model inválido '$t_model' — ignorando"
    t_model=""
  fi
  if [[ -n "$t_effort" && ${VALID_EFFORTS[(Ie)$t_effort]} -eq 0 ]]; then
    print "  ⚠ $key · trailer agent-config com effort inválido '$t_effort' — ignorando"
    t_effort=""
  fi
  model="${MODEL_OVERRIDE:-${t_model:-$DEFAULT_MODEL}}"
  effort="${EFFORT_OVERRIDE:-${t_effort:-$DEFAULT_EFFORT}}"
  profile=$(profile_for "$model" "$effort")

  if [[ "$repo_key" == "-" ]]; then
    print "! $key · pendência: sem trailer 'repo: \`…\`' no body — capture com \`work\` dentro do repo, ou adicione o trailer"
    pendencias+=("$key")
    continue
  fi
  repo_path="${repo_path_of[$repo_key]}"
  if [[ -z "$repo_path" ]]; then
    print "! $key · pendência: repo $repo_key fora do registro $REPOS_JSON"
    pendencias+=("$key")
    continue
  fi
  if [[ ! -d "$repo_path" ]]; then
    print "! $key · pendência: path registrado de $repo_key não existe: $repo_path"
    pendencias+=("$key")
    continue
  fi

  if (( running >= CAP )); then
    print "• $key · fila: cap $CAP atingido — fica em Todo"
    queued+=("$key")
    continue
  fi

  if (( dry_run )); then
    print "→ $key · [dry-run] spawnaria worktree '$slug' em $repo_key (base $BASE, perfil $profile), e moveria p/ In Progress"
    spawned+=("$key")
    (( running++ ))
    continue
  fi

  # Spec de spawn: description completa da issue + contrato do agente.
  spec_file="$spec_dir/${key}.md"
  {
    print "# $key — spec"
    print ""
    cat "$spec_dir/${key}.desc"
    print ""
    print "---"
    print ""
    agent_prompt "$key"
  } > "$spec_file"

  add_out=$( (cd "$repo_path" && workmux add "$slug" --base "$BASE" -a "$profile" --prompt-file "$spec_file" -b) 2>&1 )
  if (( $? != 0 )); then
    print "✗ $key · falha no \`workmux add $slug\` em $repo_path:"
    print -r -- "$add_out" | head -5
    pendencias+=("$key")
    continue
  fi

  if linear-gql status-set "$key" --to "In Progress" >/dev/null 2>&1; then
    print "✓ $key → worktree '$slug' ($repo_key) · perfil $profile rodando · In Progress"
  else
    print "✓ $key → worktree '$slug' ($repo_key) · perfil $profile rodando · ⚠ falha ao mover p/ In Progress — mova manualmente"
  fi
  spawned+=("$key")
  wm_windows+=("wm-$slug")
  (( running++ ))
done

if [[ -n "$only" && $matched_only -eq 0 ]]; then
  die "$only não está em Todo no team $TEAM — gate: só issues em Todo entram no sync"
fi

label_spawn="spawn"
(( dry_run )) && label_spawn="spawn (dry-run)"
print ""
print "resumo: ${#spawned[@]} $label_spawn · ${#queued[@]} fila · ${#pendencias[@]} pendência(s) · ${#deduped[@]} dedup"

# Com --only, sinaliza no exit code quando a issue pedida não avançou
# (pendência ou fila); dedup conta como sucesso idempotente.
if [[ -n "$only" ]] && (( ${#spawned[@]} == 0 && ${#deduped[@]} == 0 )); then
  exit 1
fi
exit 0
