#!/bin/zsh
# wos — hub do Work OS: visão unificada e ponto de entrada único do ciclo.
#
# Uso:
#   wos                  interativo (fzf), em loop — a mesa única. enter age
#                        por tipo: gate responde inline (vazio = focar),
#                        rodando foca a janela tmux, ⇧ PR merged roda ship,
#                        fila escolhe modelo/effort e spawna; no fim da lista,
#                        ações: capturar / triage / sync. esc sai.
#   wos ps [--tsv]       a mesma visão unificada em texto (--tsv = feed cru
#                        `kind \t handle \t label`, proto-contrato do hub)
#   wos spawn <KEY> [--model sonnet|opus|haiku] [--effort low|medium|high]
#                  [--agent claude|…] [--dry-run]
#                        disparo individual consciente. Sem flags → trailer
#                        agent-config da issue, senão política default.
#   wos peek <KEY> [n]   últimas n linhas (default 40) do pane tmux do agente
#   wos say <KEY> <txt…> envia texto (com Enter) ao pane tmux do agente
#   wos go <KEY>         no tmux: abre janela no diretório do worktree;
#                        fora: imprime o caminho (cd "$(wos go HEN-42)")
#   wos capture [...]    → work      (captura crua; alias: wos work)
#   wos triage [...]     → triage    (refinamento Backlog→Todo)
#   wos sync [...]       → linear-sync (fila→spawn em lote)
#   wos ship [...]       → ship      (fechamento: Done + worktree)
#   wos attn [...]       → attn      (painel de pendências puro)
#
# Política default de modelo/effort:
#   sonnet/medium   rotina — task bem especificada, bugfix com repro
#   opus/high       design, arquitetura, task ambígua ou de alto risco
#   haiku/low       mecânico — rename, config, doc, mudança trivial
# Por issue: trailer "agent-config: `model=<m> effort=<e>`" no body (mesmo
# estilo do trailer repo:). Precedência: flags CLI > trailer > default.

# Motor de spawn: linear-sync --only <KEY> com overrides via env
# (LINEAR_SYNC_MODEL/LINEAR_SYNC_EFFORT/LINEAR_SYNC_AGENT) — resolução de
# trailer, dedup e cap vivem lá; wos não duplica essa lógica.
# Pendências: attn --tsv é a fonte (gates, agents esperando, órfãos);
# wos não duplica essa coleta.
# Rodando: janelas tmux `wm-<slug>` (workmux) + estado por sessão via
# agents.jsonl (hooks do Claude Code, match cwd↔path do worktree) + PR via
# `gh pr list` rodado no diretório do worktree — gh falhou = sem info de PR.
# Fila: `linear-sync --queue --json` é a fonte (HEN-57) — a ordenação
# (prioridade Linear urgent→low, sem prioridade por último, depois key) é
# computada num único lugar; wos só rendera a saída.

set -o pipefail

TEAM="${WORK_LINEAR_TEAM:-HEN}"
CAP="${LINEAR_SYNC_CAP:-2}"
AGENTS="${WORK_OS_STATE:-$HOME/.local/state/work-os}/agents.jsonl"

# $0 de nível de script — dentro de função, zsh troca $0 pelo nome da função.
SELF="$0"
usage() {
  # Todo o bloco de comentário do cabeçalho (até a primeira linha em branco).
  sed -n '2,/^$/p' "$SELF" | sed 's/^# \{0,1\}//'
}

die() {
  print -u2 "wos: $*"
  exit 1
}

typeset -a VALID_MODELS=(sonnet opus haiku)
typeset -a VALID_EFFORTS=(low medium high)

# Os demais comandos do ciclo moram ao lado do wos (bin/ do repo, ou PATH).
sibling() {
  local s="${SELF:A:h}/$1"
  [[ -x "$s" ]] && { print -r -- "$s"; return }
  command -v "$1" || die "$1 não encontrado (esperado ao lado do wos)"
}

# Emite TSV `kind \t handle \t label`:
#   run:<KEY>    janela wm-<slug> viva (handle = janela tmux p/ focar)
#   ship:<KEY>   agente waiting + PR merged → falta ship
#   queue:<KEY>  issue em Todo, na ordem do linear-sync
gather_rows() {
  local queue_json panes wt_info win slug wpath branch pr ls_bin
  # fila via linear-sync --queue (HEN-57: ordenação num único lugar) —
  # falha de rede/API degrada para fila vazia, com aviso
  ls_bin=$(sibling linear-sync 2>/dev/null) || ls_bin=""
  queue_json=""
  if [[ -n "$ls_bin" ]]; then
    queue_json=$(WORK_LINEAR_TEAM="$TEAM" "$ls_bin" --queue --json 2>/dev/null) || {
      queue_json=""
      print -u2 "wos: fila Todo indisponível (linear-sync --queue falhou — rede/API?)"
    }
  else
    print -u2 "wos: linear-sync não encontrado — fila Todo indisponível"
  fi

  panes=$(tmux list-panes -a -F $'#{window_name}\t#{pane_current_path}' 2>/dev/null)

  # janelas wm-<slug> vivas → path do worktree, branch e PR (gh no diretório)
  wt_info=""
  for win in ${(f)"$(print -r -- "$panes" | cut -f1 | grep '^wm-' | sort -u)"}; do
    slug="${win#wm-}"
    local -a cand=( ~/worktrees/*/"$slug"(N/) )
    wpath="${cand[1]:-}"
    [[ -d "$wpath" ]] ||
      wpath=$(print -r -- "$panes" | awk -F'\t' -v w="$win" '$1==w {print $2; exit}')
    branch="" pr=""
    if [[ -d "$wpath" ]]; then
      branch=$(git -C "$wpath" rev-parse --abbrev-ref HEAD 2>/dev/null)
      [[ -n "$branch" ]] && pr=$(cd "$wpath" 2>/dev/null &&
        gh pr list --head "$branch" --state all --json number,state,mergedAt \
          2>/dev/null | tr -d '\n')
    fi
    wt_info+="${slug}"$'\t'"${wpath}"$'\t'"${branch}"$'\t'"${pr}"$'\n'
  done

  AGENTS="$AGENTS" python3 - "$queue_json" "$wt_info" <<'PY'
import json, os, re, sys

queue_raw, wt_raw = sys.argv[1], sys.argv[2]

# sessões do Claude Code (mesmo contrato do attn): último evento
# não-SubagentStop por sessão; pid morto → ignorar.
STATE = {"SessionStart": "working", "UserPromptSubmit": "working",
         "Stop": "waiting", "PermissionRequest": "blocked"}

def alive(pid):
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except Exception:
        return False

sessions = {}
try:
    with open(os.environ["AGENTS"]) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except Exception:
                continue
            if ev.get("event") == "SubagentStop":
                continue
            sid = ev.get("session_id")
            if sid:
                sessions[sid] = ev
except OSError:
    pass

live = [ev for ev in sessions.values()
        if ev.get("event") in STATE and alive(ev.get("pid"))]

def state_for_path(path):
    """Estado da sessão cujo cwd está no worktree (raiz ou subdir — nunca o
    contrário: sessão em diretório mais raso, ex. $HOME, não é deste worktree)."""
    if not path:
        return ""
    p = path.rstrip("/")
    best, best_ts = None, -1
    for ev in live:
        cwd = (ev.get("cwd") or "").rstrip("/")
        if not cwd:
            continue
        if cwd == p or cwd.startswith(p + "/"):
            ts = ev.get("ts") or 0
            if ts > best_ts:
                best, best_ts = ev, ts
    return STATE[best["event"]] if best else ""

# rodando: janelas wm-<slug> vivas (aceite 1)
for line in wt_raw.splitlines():
    parts = line.split("\t")
    if len(parts) < 4:
        continue
    slug, path, branch = parts[0], parts[1], parts[2]
    pr_raw = "\t".join(parts[3:])
    m = re.search(r"([A-Za-z]+-\d+)", slug)
    key = m.group(1).upper() if m else slug
    st = state_for_path(path) or "sem sessão"
    pr = {}
    try:
        arr = json.loads(pr_raw) if pr_raw else []
        if isinstance(arr, list) and arr:
            pr = arr[0]
    except Exception:
        pr = {}
    pr_state = str(pr.get("state", "")).upper()
    pr_s = f' · PR #{pr["number"]} ({pr_state})' if pr.get("number") else ""
    handle = f"wm-{slug}"
    if st == "waiting" and pr_state == "MERGED":
        print(f'ship:{key}\t{handle}\t⇧ {key} · PR #{pr["number"]} merged · falta ship (enter roda)')
    else:
        icon = {"working": "●", "waiting": "⏸", "blocked": "⛔"}.get(st, "·")
        print(f'run:{key}\t{handle}\t{icon} {key} · {st} · {branch or slug}{pr_s}')

# fila: já ordenada por `linear-sync --queue --json` (HEN-57) — wos só rendera.
try:
    queue = (json.loads(queue_raw).get("result") or {}).get("queue", []) if queue_raw else []
except Exception:
    queue = []
for item in queue:
    key = item["key"]
    label = item.get("priorityLabel", "?")
    title = item.get("title", "")
    print(f'queue:{key}\t\t○ {key} · {label} · {title[:80]}')
PY
}

# Visão unificada: pendências (attn --tsv, sem as linhas summary) + rodando + fila.
gather_all() {
  local pend rows attn_bin
  # sibling em command substitution não pode "die" (subshell) — attn ausente
  # degrada para painel sem pendências, em silêncio.
  attn_bin=$(sibling attn 2>/dev/null) || attn_bin=""
  pend=""
  [[ -n "$attn_bin" ]] && pend=$("$attn_bin" --tsv 2>/dev/null |
    awk -F'\t' '$1 ~ /^(gate:|input$|waiting$|orphan$)/')
  rows=$(gather_rows) || return 1
  [[ -n "$pend" ]] && print -r -- "$pend"
  [[ -n "$rows" ]] && print -r -- "$rows"
  return 0
}

# KEY → `handle \t path \t name` do worktree em ~/worktrees/<project>/<slug>
# (slug contém a key); handle = janela tmux wm-<slug> se estiver viva.
resolve_wt() {
  local key="${(L)1}" d slug win
  local wins
  wins=$(tmux list-windows -a -F '#{window_name}' 2>/dev/null)
  local -a dirs=( ~/worktrees/*/*(N/) )
  for d in "${dirs[@]}"; do
    slug="${d:t}"
    [[ "-${(L)slug}-" == *"-${key}-"* ]] || continue
    win="wm-$slug"
    print -r -- "$wins" | grep -qx -- "$win" || win=""
    print -r -- "${win}"$'\t'"${d}"$'\t'"${slug}"
    return 0
  done
  # sem diretório: uma janela viva ainda pode existir (worktree movido à mão)
  for win in ${(f)"$(print -r -- "$wins" | grep '^wm-')"}; do
    slug="${win#wm-}"
    [[ "-${(L)slug}-" == *"-${key}-"* ]] || continue
    print -r -- "${win}"$'\t'''$'\t'"${slug}"
    return 0
  done
  return 1
}

require_wt() {
  local key="${(U)1}" row
  row=$(resolve_wt "$key")
  [[ -n "$row" ]] || die "nenhum worktree ativo vinculado a $key"
  print -r -- "$row"
}

# ---------- wos ps ----------
cmd_ps() {
  local tsv=0
  [[ "$1" == --tsv ]] && tsv=1
  local rows
  rows=$(gather_all) || exit 1
  if (( tsv )); then
    print -r -- "$rows"
    return
  fi
  local -a pend=( ${(f)"$(print -r -- "$rows" |
    awk -F'\t' '$1 ~ /^(gate:|input$|waiting$|orphan$)/')"} )
  local -a run=( ${(f)"$(print -r -- "$rows" | grep -E '^(run|ship):')"} )
  local -a queue=( ${(f)"$(print -r -- "$rows" | grep '^queue:')"} )
  print "pendências (${#pend[@]}):"
  if (( ${#pend[@]} )); then
    for r in "${pend[@]}"; do print -r -- "  ${r##*$'\t'}"; done
  else
    print "  (nenhuma — nada precisa de você)"
  fi
  print "rodando (${#run[@]}/cap $CAP):"
  if (( ${#run[@]} )); then
    for r in "${run[@]}"; do print -r -- "  ${r##*$'\t'}"; done
  else
    print "  (nenhuma janela wm-* viva)"
  fi
  print "fila Todo (${#queue[@]}, ordem do sync):"
  if (( ${#queue[@]} )); then
    for r in "${queue[@]}"; do print -r -- "  ${r##*$'\t'}"; done
  else
    print "  (vazia)"
  fi
}

# ---------- wos spawn ----------
cmd_spawn() {
  local key="" model="" effort="" agent="" dry=0
  while (( $# )); do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --model)  shift; model="$1" ;;
      --effort) shift; effort="$1" ;;
      --agent)  shift; agent="$1" ;;
      --dry-run) dry=1 ;;
      -*) die "flag desconhecida: $1 (veja wos --help)" ;;
      *) [[ -n "$key" ]] && die "só uma issue por spawn (recebi '$key' e '$1')"
         key="${(U)1}" ;;
    esac
    shift
  done
  [[ -n "$key" ]] || die "spawn requer uma issue key (ex.: wos spawn HEN-42)"
  [[ -z "$model" || ${VALID_MODELS[(Ie)$model]} -gt 0 ]] ||
    die "--model inválido: $model (use: $VALID_MODELS)"
  [[ -z "$effort" || ${VALID_EFFORTS[(Ie)$effort]} -gt 0 ]] ||
    die "--effort inválido: $effort (use: $VALID_EFFORTS)"

  local -a envv=()
  [[ -n "$model" ]] && envv+=("LINEAR_SYNC_MODEL=$model")
  [[ -n "$effort" ]] && envv+=("LINEAR_SYNC_EFFORT=$effort")
  [[ -n "$agent" ]] && envv+=("LINEAR_SYNC_AGENT=$agent")
  local -a args=(--only "$key")
  (( dry )) && args+=(--dry-run)
  env "${envv[@]}" "$(sibling linear-sync)" "${args[@]}"
}

# ---------- wos peek / say / go — a sessão do agente no seu tmux ----------
cmd_peek() {
  local key="$1" n="${2:-40}"
  [[ -n "$key" ]] || die "uso: wos peek <KEY> [linhas]"
  local row handle
  row=$(require_wt "$key") || exit 1
  handle="${row%%$'\t'*}"
  [[ -n "$handle" ]] || die "worktree de ${(U)key} não tem janela tmux viva"
  tmux capture-pane -p -t "$handle" -S "-$n" 2>/dev/null | tail -n "$n" ||
    die "falha ao capturar (janela morta?)"
}

cmd_say() {
  local key="$1"
  (( $# )) && shift
  [[ -n "$key" && $# -gt 0 ]] || die "uso: wos say <KEY> <texto…>"
  local row handle
  row=$(require_wt "$key") || exit 1
  handle="${row%%$'\t'*}"
  [[ -n "$handle" ]] || die "worktree de ${(U)key} não tem janela tmux viva"
  tmux send-keys -t "$handle" -l -- "$*" 2>/dev/null &&
    tmux send-keys -t "$handle" Enter 2>/dev/null &&
    print "→ enviado ao agente de ${(U)key}" ||
    die "falha ao enviar (janela morta?)"
}

cmd_go() {
  local key="$1"
  [[ -n "$key" ]] || die "uso: wos go <KEY>"
  local row rest wpath
  row=$(require_wt "$key") || exit 1
  rest="${row#*$'\t'}"
  wpath="${rest%%$'\t'*}"
  [[ -d "$wpath" ]] || die "diretório do worktree não existe: $wpath"
  if [[ -n "$TMUX" ]]; then
    tmux new-window -c "$wpath" -n "${(U)key}"
  else
    print -r -- "$wpath"
  fi
}

# ---------- interativo (default): mesa única em loop ----------
pause_panel() {
  print
  print -n "qualquer tecla volta ao painel…"
  read -k 1 -s
  print
}

pick_and_spawn() {
  local key="$1"
  local msel model effort
  msel=$(printf '%s\n' \
    $'default\t(trailer agent-config da issue, senão sonnet/medium)' \
    $'sonnet\trotina — task bem especificada' \
    $'opus\tdesign, arquitetura, task ambígua' \
    $'haiku\tmecânico — rename, config, doc' |
    fzf --delimiter '\t' --with-nth 1,2 --no-multi \
        --header "modelo p/ $key" --prompt 'modelo> ' --height=40% --layout=reverse)
  [[ -z "$msel" ]] && return
  model="${msel%%$'\t'*}"
  msel=$(printf '%s\n' \
    $'default\t(trailer da issue, senão medium)' \
    $'low\tmecânico' \
    $'medium\trotina' \
    $'high\tdesign/ambíguo' |
    fzf --delimiter '\t' --with-nth 1,2 --no-multi \
        --header "effort p/ $key ($model)" --prompt 'effort> ' --height=40% --layout=reverse)
  [[ -z "$msel" ]] && return
  effort="${msel%%$'\t'*}"
  local -a flags=()
  [[ "$model" != default ]] && flags+=(--model "$model")
  [[ "$effort" != default ]] && flags+=(--effort "$effort")
  cmd_spawn "$key" "${flags[@]}"
  pause_panel
}

focus_pane() {
  local handle="$1" label="$2"
  if [[ -n "$handle" ]] && tmux select-window -t "$handle" 2>/dev/null; then
    print -r -- "→ focado na janela tmux $handle: $label"
  else
    print -u2 "wos: janela não encontrada"
    pause_panel
  fi
}

# gate: responder inline direto do painel; resposta vazia = focar a janela.
answer_inline() {
  local kind="$1" handle="$2" label="$3"
  print -r -- "$label"
  local resp=""
  read -r "resp?resposta (vazio = focar janela, esc+enter cancela)> "
  # esc+enter (ou sequência de seta) chega como \e literal no buffer — cancelar,
  # nunca resolver o gate com caractere de controle como resposta.
  [[ "$resp" == *$'\e'* ]] && { print "cancelado"; return }
  if [[ -z "$resp" ]]; then
    focus_pane "$handle" "$label"
    return
  fi
  case "$kind" in
    gate:*)
      "$(sibling gates)" resolve --id "${kind#gate:}" --resolution "$resp" \
        >/dev/null 2>&1 && print "✓ gate resolvido (a resposta entra na próxima rodada da triagem)" ||
        print -u2 "wos: falha ao resolver o gate ${kind#gate:}"
      ;;
  esac
  pause_panel
}

cmd_fzf() {
  command -v fzf >/dev/null || { cmd_ps; return }
  # se um caller exótico nos der stdin não-tty, os read/scripts interativos
  # receberiam EOF — religar no tty do terminal.
  [[ -t 0 ]] || exec </dev/tty
  local actions rows sel kind rest handle label
  actions=$'act:capture\t\t＋ capturar ideia (work)\nact:triage\t\t▸ triage — refinar Backlog\nact:sync\t\t▸ sync — spawn em lote da fila'

  while true; do
    rows=$(gather_all) || exit 1
    if [[ -n "$rows" ]]; then
      rows="$rows"$'\n'"$actions"
    else
      rows="$actions"
    fi

    sel=$(print -r -- "$rows" |
      fzf --delimiter '\t' --with-nth 3 --no-multi \
          --header "enter age por tipo · ⛔ responde/foca · ●⏸💤 foca · ⇧ ship · ○ spawna · esc sai" \
          --prompt 'wos> ' --height=100% --layout=reverse)
    [[ -z "$sel" ]] && return

    kind="${sel%%$'\t'*}"
    rest="${sel#*$'\t'}"
    handle="${rest%%$'\t'*}"
    label="${rest#*$'\t'}"

    case "$kind" in
      gate:*) answer_inline "$kind" "$handle" "$label" ;;
      run:*|input|waiting|orphan) focus_pane "$handle" "$label" ;;
      ship:*)
        "$(sibling ship)" "${kind#ship:}"
        pause_panel
        ;;
      queue:*) pick_and_spawn "${kind#queue:}" ;;
      act:capture)
        "$(sibling work)"
        pause_panel
        ;;
      act:triage)
        "$(sibling triage)"
        pause_panel
        ;;
      act:sync)
        "$(sibling linear-sync)"
        pause_panel
        ;;
    esac
  done
}

case "$1" in
  -h|--help) usage; exit 0 ;;
  ps)           shift; cmd_ps "$@" ;;
  spawn)        shift; cmd_spawn "$@" ;;
  peek)         shift; cmd_peek "$@" ;;
  say)          shift; cmd_say "$@" ;;
  go)           shift; cmd_go "$@" ;;
  capture|work) shift; exec "$(sibling work)" "$@" ;;
  triage)       shift; exec "$(sibling triage)" "$@" ;;
  sync)         shift; exec "$(sibling linear-sync)" "$@" ;;
  ship)         shift; exec "$(sibling ship)" "$@" ;;
  attn)         shift; exec "$(sibling attn)" "$@" ;;
  "")           cmd_fzf ;;
  *)            usage >&2; die "subcomando desconhecido: $1" ;;
esac
