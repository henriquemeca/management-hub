#!/bin/zsh
# attn — painel de atenção: agrega pendências que exigem o humano e leva à janela certa.
#
# Uso:
#   attn             interativo (fzf) → selecionar foca a janela tmux
#   attn --list      só lista as pendências (sem fzf), para scripts/testes
#   attn --tsv       lista crua `tipo<TAB>handle<TAB>label`, para integrações
#   attn --popup     interativo + pausa final (popup tmux)
#
# Fontes agregadas (local-first, sem Orca):
#   gates pendentes    gates list --status pending --json   (fila local de decisões)
#   agents esperando   agents.jsonl (hooks do Claude Code) × liveness (kill -0)
#   worktrees órfãos   ~/worktrees/*/* sem janela tmux `wm-<slug>` (workmux)
# Sem pendências → resumo das sessões vivas (agents.jsonl + janelas wm-*).

set -o pipefail

# $0 de nível de script — dentro de função, zsh troca $0 pelo nome da função.
SELF="$0"
usage() {
  sed -n '2,8p' "$SELF" | sed 's/^# \{0,1\}//'
}

AGENTS="${WORK_OS_STATE:-$HOME/.local/state/work-os}/agents.jsonl"

mode=fzf
popup=0
case "$1" in
  -h|--help) usage; exit 0 ;;
  --list) mode=list ;;
  --tsv) mode=tsv ;;
  --popup) popup=1 ;;
esac

pause() { (( popup )) && { print -n "qualquer tecla fecha…"; read -k 1 -s; } }

# Irmãos moram ao lado do attn (bin/ do repo) ou no PATH.
sibling() {
  local s="${SELF:A:h}/$1"
  [[ -x "$s" ]] && { print -r -- "$s"; return }
  command -v "$1"
}

# Degradação: cada fonte que falhar vira vazio — nunca aborta o painel inteiro.
gates_bin=$(sibling gates) || gates_bin=""
gates_json=""
if [[ -n "$gates_bin" ]]; then
  gates_json=$("$gates_bin" list --status pending --json 2>/dev/null) || {
    gates_json=""
    print -u2 "attn: gates indisponível — seguindo sem gates"
  }
fi
panes=$(tmux list-panes -a -F $'#{window_name}\t#{pane_current_path}' 2>/dev/null)

# Junta as fontes e emite TSV: tipo \t handle \t label
# (handle = nome de janela tmux; vazio = pendência sem janela — selecionar
# mostra a ação em vez de focar)
rows=$(ATTN_AGENTS="$AGENTS" python3 - "$gates_json" "$panes" <<'PY'
import glob, json, os, re, sys, time

gates_raw, panes_raw = sys.argv[1], sys.argv[2]

try:
    gates = json.loads(gates_raw).get("gates", []) if gates_raw else []
except Exception:
    gates = []

panes = []                      # (janela, cwd do pane)
for line in panes_raw.splitlines():
    if "\t" in line:
        w, p = line.split("\t", 1)
        panes.append((w, p))
windows = {w for w, _ in panes}
wm_windows = {w for w in windows if w.startswith("wm-")}

def window_for_path(cwd):
    """Janela cujo pane casa com o cwd da sessão (match por prefixo de path)."""
    if not cwd:
        return ""
    c = cwd.rstrip("/")
    best, best_len = "", -1
    for w, p in panes:
        p = p.rstrip("/")
        if p == c or p.startswith(c + "/") or c.startswith(p + "/"):
            if len(p) > best_len:
                best, best_len = w, len(p)
    return best

def window_for_key(key):
    """Janela wm-<slug> do worktree de uma issue KEY (slug contém a key)."""
    k = key.lower()
    for w in sorted(wm_windows):
        if f"-{k}-" in f"-{w[3:]}-":
            return w
    return ""

# Sessões do Claude Code: último evento não-SubagentStop por sessão decide o
# estado; pid morto → sessão encerrada, ignorar.
STATE = {"SessionStart": "working", "UserPromptSubmit": "working",
         "Stop": "waiting", "PermissionRequest": "blocked"}

def alive(pid):
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except Exception:
        return False

sessions = {}
try:
    with open(os.environ["ATTN_AGENTS"]) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except Exception:
                continue
            if ev.get("event") == "SubagentStop":
                continue
            sid = ev.get("session_id")
            if sid:
                sessions[sid] = ev  # log append-only cronológico: último vence
except OSError:
    pass

live = [ev for ev in sessions.values()
        if ev.get("event") in STATE and alive(ev.get("pid"))]

def emit(kind, handle, label):
    print(f'{kind}\t{handle}\t{label}')

pend = 0
now = time.time()

for g in gates:
    task = g.get("task") or ""
    q = (g.get("question") or "?").replace("\n", " ")[:100]
    m = re.search(r"\b([A-Za-z]+-\d+)\b", task)
    handle = window_for_key(m.group(1)) if m else ""
    emit(f'gate:{g.get("id", "")}', handle, f'⛔ gate · [{task}] {q}')
    pend += 1

for ev in sorted(live, key=lambda e: e.get("ts") or 0):
    st = STATE[ev["event"]]
    cwd = ev.get("cwd") or ""
    name = os.path.basename(cwd.rstrip("/")) or cwd or "?"
    handle = window_for_path(cwd)
    age = max(0, now - (ev.get("ts") or now))
    h, mins = int(age // 3600), int(age % 3600 // 60)
    ago = f"{h}h{mins:02d}" if h else f"{mins}min"
    if st == "blocked":
        emit("input", handle, f'⏸ input · {name} · sessão pediu permissão (há {ago})')
        pend += 1
    elif st == "waiting" and age < 86400:
        emit("waiting", handle, f'💤 waiting · {name} · agente parado há {ago}')
        pend += 1

wt_root = os.path.expanduser("~/worktrees")
for d in sorted(glob.glob(os.path.join(wt_root, "*", "*"))):
    if not os.path.isdir(d):
        continue
    slug = os.path.basename(d)
    if f"wm-{slug}" not in windows:
        proj = os.path.basename(os.path.dirname(d))
        emit("orphan", "", f'⚠ órfão · {proj}/{slug} sem janela wm-{slug}')
        pend += 1

if pend == 0:
    # aceite: sem pendências → resumo das sessões vivas
    seen = set()
    for ev in sorted(live, key=lambda e: e.get("ts") or 0):
        st = STATE[ev["event"]]
        cwd = ev.get("cwd") or ""
        name = os.path.basename(cwd.rstrip("/")) or "?"
        handle = window_for_path(cwd)
        if handle:
            seen.add(handle)
        emit("summary", handle, f'● {name} — {st} · pid {ev.get("pid", "?")}')
    for w in sorted(wm_windows - seen):
        emit("summary", w, f'● {w} — janela viva, sem sessão registrada')
PY
)

if [[ -z "$rows" ]]; then
  print "attn: nenhuma sessão ativa"
  pause
  exit 0
fi

if [[ "$mode" == list ]]; then
  print -r -- "$rows" | cut -f3
  exit 0
elif [[ "$mode" == tsv ]]; then
  print -r -- "$rows"
  exit 0
fi

header="pendências → enter foca a janela tmux"
print -r -- "$rows" | head -1 | grep -q '^summary' &&
  header="sem pendências — sessões vivas (enter foca)"

sel=$(print -r -- "$rows" |
  fzf --delimiter '\t' --with-nth 3 --no-multi --header "$header" \
      --prompt 'atenção> ' --height=100% --layout=reverse)
[[ -z "$sel" ]] && exit 0

kind="${sel%%$'\t'*}"
rest="${sel#*$'\t'}"
handle="${rest%%$'\t'*}"
label="${rest#*$'\t'}"

if [[ -n "$handle" ]] && tmux select-window -t "$handle" 2>/dev/null; then
  print "→ focado na janela tmux $handle: $label"
else
  [[ -n "$handle" ]] && print -u2 "attn: janela não encontrada ($handle)"
  print -r -- "$label"
  case "$kind" in
    gate:*) print "resolver: gates resolve --id ${kind#gate:} --resolution '<texto>'" ;;
    *)      print "(pendência sem janela associada)" ;;
  esac
  pause
fi
