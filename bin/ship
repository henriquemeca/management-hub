#!/bin/zsh
# ship — comando determinístico de fechamento: fecha issue e remove a worktree.
#
# Uso:
#   ship HEN-XX           fecha a issue: exige PR MERGED, marca Done, remove a worktree
#   ship HEN-XX --force   pula o gate de PR MERGED e repassa --force ao workmux remove
#
# Decisão da sessão HEN-33: comando, não skill — sequência 100% mecânica, sem
# julgamento de LLM. "done" literal não dá: é palavra reservada do zsh.
#
# Fluxo:
#   1. linear-gql issue HEN-XX → acha o PR: última URL github.com/.../pull/N
#      na description ou nos comentários (o agente comenta o PR ao integrar)
#   2. gh pr view <url> --json state → exige MERGED; senão aborta (--force pula)
#   3. linear-gql status-set HEN-XX --to Done
#   4. localiza a worktree workmux: slug = parte após a última '/' do
#      branchName da issue (fallback: identifier minúsculo — mesma derivação
#      do linear-sync); repo = trailer `repo: ...` do body (última ocorrência
#      vence), resolvido em path via ~/.local/state/work-os/repos.json;
#      confirmação via (cd <repo> && workmux list --json)
#   5. (cd <repo> && workmux remove <slug>) → worktree + janela tmux + branch
#      local (sem --force o workmux pede confirmação; --force do ship repassa)
#
# Guard-rails (ifs, não julgamento — nenhum tem --force):
#   - recusa worktree com mudanças não commitadas (git status --porcelain sujo)
#   - recusa worktree sem upstream configurado ou com commits não pushados
#   - recusa rodar de dentro da própria worktree (não se auto-remover)
#
# Idempotente: issue já Done vira no-op nos passos 1-3; worktree já removida
# (ou nunca existiu) vira no-op nos passos 4-5. Re-rodar é sempre seguro.
#
# Chamadores previstos: Henrique no terminal pós-merge; linear-sync num futuro
# poll de merge; agentes coordenadores. Agente executor NUNCA chama ship — está
# dentro da worktree que seria removida; ele para em In Review.

set -o pipefail

REPOS_JSON="$HOME/.local/state/work-os/repos.json"

SELF="$0"
usage() {
  sed -n '2,/^$/p' "$SELF" | sed 's/^# \{0,1\}//'
}

die() {
  print -u2 "ship: $*"
  exit 1
}

# ---------- args ----------
force=0
key=""
while (( $# )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --force) force=1 ;;
    -*) die "flag desconhecida: $1 (veja ship --help)" ;;
    *)
      [[ -n "$key" ]] && die "argumento inesperado: $1"
      key="${(U)1}"
      ;;
  esac
  shift
done
[[ -n "$key" ]] || { usage; die "uso: ship HEN-XX" }

# ---------- 1-3: issue → PR MERGED → Done ----------
issue_raw=$(linear-gql issue "$key" 2>&1)
[[ $? -eq 0 ]] ||
  die "falha ao ler a issue $key — falha na API do Linear (LINEAR_API_KEY? rede?):"$'\n'"$issue_raw"

# 4 linhas: estado · URL do PR · canonicalKey do trailer repo: · slug da
# worktree — "-" = ausente (${(f)} colapsaria linhas vazias).
info=$(RAW="$issue_raw" python3 - <<'PY'
import json, os, re, sys
try:
    issue = json.loads(os.environ["RAW"], strict=False)
except Exception:
    sys.exit(1)
print((issue.get("state") or {}).get("name") or "-")
desc = issue.get("description") or ""
texts = [desc] + [c.get("body") or ""
                  for c in (issue.get("comments") or {}).get("nodes", [])]
urls = []
for t in texts:
    urls += re.findall(r"https://github\.com/[^\s()<>\"'`\]]+/pull/\d+", t)
print(urls[-1] if urls else "-")
# Trailer = linha própria; última ocorrência vence (o body pode citar o
# formato como exemplo no meio do texto — bug HEN-37).
ms = re.findall(r"(?m)^repo: `([^`]+)`\s*$", desc)
print(ms[-1] if ms else "-")
branch = issue.get("branchName") or ""
print(branch.rsplit("/", 1)[-1] if branch else issue.get("identifier", "").lower() or "-")
PY
)
[[ $? -eq 0 && -n "$info" ]] || die "resposta inesperada do linear-gql para $key"
info_lines=( ${(f)info} )
state_name="${info_lines[1]}"
pr_url="${info_lines[2]}"
repo_key="${info_lines[3]}"
slug="${info_lines[4]}"
[[ "$state_name" != "-" ]] || die "issue $key sem estado — resposta inesperada do Linear"

if [[ "$state_name" == "Done" ]]; then
  print "= $key · já está Done — pulando passos 1-3"
else
  [[ "$pr_url" != "-" ]] ||
    die "nenhum PR encontrado na issue $key (description/comentários) — comente a URL do PR antes de rodar ship"

  if (( force )); then
    print "⚠ $key · --force: pulando o gate de PR MERGED (PR: $pr_url)"
  else
    pr_raw=$(gh pr view "$pr_url" --json state 2>&1)
    [[ $? -eq 0 ]] || die "falha ao consultar o PR via gh: $pr_raw"
    pr_state=$(print -r -- "$pr_raw" | python3 -c 'import json, sys; print(json.load(sys.stdin).get("state", ""))' 2>/dev/null)
    [[ "$pr_state" == "MERGED" ]] || die "PR $pr_url não está MERGED (estado: ${pr_state:-desconhecido}) — use --force para forçar exceção"
  fi

  st_raw=$(linear-gql status-set "$key" --to Done 2>&1)
  [[ $? -eq 0 ]] || die "falha ao mover $key para Done: $st_raw"
  print "✓ $key → Done"
fi

# ---------- 4: acha a worktree vinculada ----------
if [[ "$repo_key" == "-" ]]; then
  print "= $key · sem trailer 'repo: \`…\`' no body — nenhuma worktree a remover"
  exit 0
fi

repo_path=$(REPO_KEY="$repo_key" REPOS_JSON="$REPOS_JSON" python3 - <<'PY'
import json, os
try:
    with open(os.environ["REPOS_JSON"]) as f:
        repos = json.load(f)
except Exception:
    repos = {}
print(repos.get(os.environ["REPO_KEY"], ""))
PY
)
if [[ -z "$repo_path" || ! -d "$repo_path" ]]; then
  print "= $key · repo $repo_key não registrado em $REPOS_JSON — nenhuma worktree a remover"
  exit 0
fi

wt_path=$(cd "$repo_path" && workmux list --json 2>/dev/null |
  SLUG="$slug" python3 -c '
import json, os, sys
try:
    worktrees = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for w in worktrees:
    if not w.get("is_main") and w.get("handle") == os.environ["SLUG"]:
        print(w.get("path", ""))
        break
')

if [[ -z "$wt_path" ]]; then
  print "= $key · nenhuma worktree '$slug' em $repo_key — nada a remover"
  exit 0
fi

# ---------- guard-rails ----------
[[ "${PWD:A}/" == "${wt_path:A}/"* ]] &&
  die "não posso remover a worktree em que estou rodando ($wt_path) — rode ship de fora dela"

dirty=$(git -C "$wt_path" status --porcelain 2>&1)
[[ -n "$dirty" ]] &&
  die "worktree $wt_path tem mudanças não commitadas — commit ou descarte antes de rodar ship:"$'\n'"$dirty"

upstream=$(git -C "$wt_path" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>&1)
if [[ $? -ne 0 ]]; then
  die "worktree $wt_path sem branch upstream configurado — dê push antes de rodar ship"
fi
ahead=$(git -C "$wt_path" rev-list --count '@{u}..HEAD' 2>&1)
[[ "$ahead" == <-> && "$ahead" -gt 0 ]] &&
  die "worktree $wt_path tem $ahead commit(s) não pushado(s) — dê push antes de rodar ship"

# ---------- 5: remove worktree + janela tmux + branch ----------
rm_args=("$slug")
(( force )) && rm_args+=(--force)
if (cd "$repo_path" && workmux remove "${rm_args[@]}"); then
  print "✓ $key · worktree $wt_path removida (worktree + janela tmux + branch local)"
else
  die "falha ao remover a worktree $wt_path — veja a saída do workmux acima"
fi
